  ui.box(gx0+18,437,12,1); ui.box(gx0+18,448,12,1); ui.box(gx0+18,437,1,12); ui.box(gx0+29,437,1,12);
  gon ? ( gset(0.3,0.8,1,1); ui.box(gx0+21,440,6,6); );
