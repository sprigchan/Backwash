    ui.btn(gx0+5,530,61,18,sv[26] == 0);
    ui.btn(gx0+70,530,61,18,sv[26] == 1);
    gset(0.85,0.93,1,gon ? 1 : 0.5);
    strcpy(#t,"SOFT"); gfx_measurestr(#t,gtw,gth); gfx_x = ui.px(gx0+35.5)-gtw*0.5; gfx_y = ui.py(535); gfx_drawstr(#t);
    strcpy(#t,"HARD"); gfx_measurestr(#t,gtw,gth); gfx_x = ui.px(gx0+100.5)-gtw*0.5; gfx_y = ui.py(535); gfx_drawstr(#t);
  );
  ge == 2 ? (
    // distortion type selector:  < SOFT >
    ui.btn(gx0+5,530,126,18,0);
    gset(0.45,0.8,1,gon ? 1 : 0.5);
    ui.tri(gx0+11,539,gx0+17,535,gx0+17,543);
    ui.tri(gx0+125,539,gx0+119,535,gx0+119,543);
    gl2 = floor(sv[39]+0.5);
    gl2 == 0 ? strcpy(#t,"SOFT") : gl2 == 1 ? strcpy(#t,"TUBE") : gl2 == 2 ? strcpy(#t,"HARD CLIP") : strcpy(#t,"FUZZ");
    gset(0.85,0.93,1,gon ? 1 : 0.5);
    gfx_measurestr(#t,gtw,gth);
    gfx_x = ui.px(gx0+68)-gtw*0.5; gfx_y = ui.py(535); gfx_drawstr(#t);
  );
  );
  gsl += 1;
);

// ----- knobs (everything) -----
gk = 0;
while (gk < 20) (
  gcx = kt[gk*8]; gcy = kt[gk*8+1]; gr = kt[gk*8+2]; gn = kc[gk*6+4];
  gal = 1;
  gk >= 4 ? ( gal = sv[fxs(gk == 19 ? 3 : gk < 16 ? floor((gk-4)/2)+1 : 7)] ? 1 : 0.45; );
  gcx > -500 ? (
  gset(0.1,0.12,0.2,gal); ui.dot(gcx,gcy,gr-3,1);
  gset(0.2,0.25,0.38,gal); ui.dot(gcx,gcy,gr-3,0);
  gset(0.16,0.2,0.32,gal);
  gj = 0; while (gj < 3) ( ui.arc(gcx,gcy,gr-gj*0.8,-2.356,2.356); gj += 1; );
  gn > 0.002 ? (
    gset(0.3,0.75,1,gal);
    gj = 0; while (gj < 3) ( ui.arc(gcx,gcy,gr-gj*0.8,-2.356,-2.356+gn*4.712); gj += 1; );
  );
  ga = -2.356+gn*4.712;
  gset(0.92,0.96,1,gal);
  ui.dot(gcx+sin(ga)*gr*0.5, gcy-cos(ga)*gr*0.5, 1.8, 1);

  // label
  gk == 1 ? strcpy(#kl,"SHAPE") : gk == 2 ? strcpy(#kl,"WIDTH") : gk == 3 ? strcpy(#kl,"LEVEL") :
  gk == 4 ? strcpy(#kl,"PITCH") : gk == 5 ? strcpy(#kl,"CURVE") :
  gk == 6 ? strcpy(#kl,"DRIVE") : gk == 7 ? strcpy(#kl,"MIX") :
  gk == 8 ? strcpy(#kl,"DEPTH") : gk == 9 ? strcpy(#kl,"RESO") :
  gk == 10 ? strcpy(#kl,"AMOUNT") : gk == 11 ? strcpy(#kl,"RATE") :
  gk == 12 ? strcpy(#kl,"DEPTH") : gk == 13 ? strcpy(#kl,"RATE") :
  gk == 14 ? strcpy(#kl,"DEPTH") : gk == 15 ? strcpy(#kl,"RATE") :
  gk == 16 ? strcpy(#kl,"AMOUNT") : gk == 17 ? strcpy(#kl,"BALANCE") : gk == 19 ? strcpy(#kl,"NOISE") : strcpy(#kl,"MIX");
  // value
  gvv = sv[kc[gk*6]];
  (gk == 1 || gk == 2 || (gk >= 5 && gk <= 10) || gk == 12 || gk == 14 || gk >= 16) ? ( sprintf(#kv,"%d",gvv); strcat(#kv,"%"); ) :
  gk == 3 ? sprintf(#kv,"%.1f dB",gvv) :
  gk == 4 ? sprintf(#kv,"-%.1f st",gvv) :
  gk == 11 ? sprintf(#kv,"%.2f Hz",gvv) :
  gk == 13 ? sprintf(#kv,"%.1f Hz",gvv) :
  gk == 15 ? sprintf(#kv,"%.2f Hz",gvv) : strcpy(#kv,"");
  gfx_setfont(2);
  gk > 0 ? (
    gfx_setfont((gk >= 16 || gk == 8 || gk == 9) ? 4 : 2);   // smaller labels on the 3-knob Bitcrusher card
    gset(0.5,0.62,0.8,gal);
    gfx_measurestr(#kl,gtw,gth);
    gfx_x = ui.px(gcx)-gtw*0.5; gfx_y = ui.py(gcy-gr-13); gfx_drawstr(#kl);
    gfx_setfont(2);
    gset(0.78,0.88,1,gal);
    gfx_measurestr(#kv,gtw,gth);
    gfx_x = ui.px(gcx)-gtw*0.5; gfx_y = ui.py(gcy+gr+4); gfx_drawstr(#kv);
  );
  );
  gk += 1;
);

// ===== hint line =====
strcpy(#hint2,"");
ghov == 0 ? strcpy(#hint,"LENGTH: total duration of the reverse reverb (tempo-synced or in milliseconds).") :
ghov == 1 ? strcpy(#hint,"SHAPE: how the swell builds - lower = earlier, higher = later and sharper.") :
ghov == 2 ? strcpy(#hint,"WIDTH: stereo width of the result (100% = original).") :
ghov == 3 ? strcpy(#hint,"LEVEL: output gain of the reverse reverb in dB.") :
ghov == 4 ? strcpy(#hint,"PITCH RISER PITCH: The starting pitch in semitones below the original pitch.") :
ghov == 5 ? strcpy(#hint,"PITCH RISER CURVE: How the pitch climbs. Lower values climb steadily. Higher values stay low and save the climb for the very end.") :
ghov == 6 ? strcpy(#hint,"SATURATION DRIVE: how hard the signal is pushed into the selected distortion type.") :
ghov == 7 ? strcpy(#hint,"SATURATION MIX: blend between the clean and the saturated sound.") :
ghov == 8 ? strcpy(#hint,"SWEEP DEPTH: how far below fully open the low-pass filter starts before it opens up.") :
ghov == 9 ? strcpy(#hint,"SWEEP RESONANCE: emphasis of the sweeping filter.") :
ghov == 10 ? strcpy(#hint,"MODULATION AMOUNT: depth of the chorus / flanger / phaser movement.") :
ghov == 11 ? strcpy(#hint,"MODULATION RATE: speed of the modulation in Hz.") :
ghov == 12 ? strcpy(#hint,"TREMOLO DEPTH: how much the volume is reduced on each pulse.") :
ghov == 13 ? strcpy(#hint,"TREMOLO RATE: speed of the pulses in Hz.") :
ghov == 14 ? strcpy(#hint,"AUTO PAN DEPTH: how far the sound travels towards the left and right (100% = full left to full right).") :
ghov == 15 ? strcpy(#hint,"AUTO PAN RATE: speed of the left / right movement in Hz.") :
ghov == 16 ? strcpy(#hint,"BITCRUSHER AMOUNT: total sample-rate and bit-depth reduction. The balance knob decides how it is shared between the two.") :
ghov == 17 ? strcpy(#hint,"BITCRUSHER BALANCE: 0% = bit depth reduction only, 50% = both equally, 100% = sample-rate reduction only.") :
ghov == 18 ? strcpy(#hint,"BITCRUSHER MIX: blend between the clean and the crushed sound.") :
ghov == 19 ? strcpy(#hint,"SWEEP NOISE: white noise that follows the loudness of the reversed audio - quiet at the start, loud at the end. The sweep filter shapes it too.") :
ghov == 106 ? (
  strcpy(#hint,"FILTER: drag the HP / LP points. Drag the amber BELL point: left / right = frequency, up / down = gain.");
  strcpy(#hint2,"Mouse wheel over the graph = bell Q.  Ctrl+click on a point = reset it (HP / LP / bell).");
) :
ghov == 105 ? strcpy(#hint,"SATURATION TYPE: SOFT = smooth clipper, TUBE = warm asymmetric, HARD CLIP = flat-top clipping, FUZZ = heavy asymmetric fuzz.") :
ghov == 104 ? strcpy(#hint,"AUTO PAN SHAPE: SINE = smooth sweep, TRI = linear sweep, SQUARE = quick jumps between left and right.") :
ghov == 100 ? strcpy(#hint,"TREMOLO SOFT / HARD: SOFT gives smooth pulses. HARD chops the sound fully on and off, like a gate.") :
ghov == 101 ? strcpy(#hint,"MODULATION MODE: CHORUS = lush doubling, FLANGER = jet sweep, PHASER = swirling notches.") :
ghov == 102 ? (
  strcpy(#hint,"CAPTURED AUDIO: Wheel = zoom, Shift+wheel = horizontal scroll, Ctrl+click = FIT. Drag markers to set the range.");
  strcpy(#hint2,"Drag between the markers to move the selection. Ctrl+click anywhere on the waveform to show the full capture.");
) :
ghov == 107 ? strcpy(#hint,"HINTS: click the ? button to hide or show this help text.") :
ghov == 108 ? strcpy(#hint,"Final result, after FX chain - click to preview with the original") :
ghov == 109 ? strcpy(#hint,"SEND TO TRACK: needs the Lua receiver script") :
ghov == 110 ? strcpy(#hint,"ABOUT: click to show information about Backwash.") :
ghov == 103 ? strcpy(#hint,"AUDIO SOURCE: how much audio, counted from the start marker, is fed into the reverb (default 250 ms). Drag up / down.") :
strcpy(#hint,"Ctrl+click = reset   |   Shift+drag = fine   |   MIDI note = trigger   |   SEND TO TRACK needs the Lua script   |   Mouse wheel = effect chain page");
gfx_setfont(2); gset(0.5,0.62,0.8,1);
slider44 == 0 ? (
  gfx_x = ui.px(16); gfx_y = ui.py(570); gfx_drawstr(#hint);
  gfx_x = ui.px(16); gfx_y = ui.py(581); gfx_drawstr(#hint2);
);
// hints on / off button (small, bottom right)
gHelpHover = mx >= 720 && mx <= 744 && my >= 568 && my <= 592;
gHelpHover ? gset(0.16,0.24,0.34,1) : gset(0.09,0.14,0.22,1);
ui.ln(720,568,744,568); ui.ln(744,568,744,592);
ui.ln(744,592,720,592); ui.ln(720,592,720,568);
gset(0.85,0.93,1,slider44 == 0 ? 1 : 0.5); gfx_setfont(5);
strcpy(#t,"?"); gfx_measurestr(#t,gtw,gth);
gfx_x = ui.px(732)-gtw*0.5; gfx_y = ui.py(568)+(24*ui.S-gth)*0.5; gfx_drawstr(#t);

