  gset(0.9,0.95,1,1); gfx_setfont(3);
  gfx_x = ui.px(32); gfx_y = ui.py(46); gfx_drawstr("BACKWASH");
  gfx_setfont(1); gset(0.82,0.88,1,1);
  gfx_x = ui.px(32); gfx_y = ui.py(76); gfx_drawstr("Created by Ruslan Vislov");
  gfx_x = ui.px(32); gfx_y = ui.py(94); gfx_drawstr("Website: vislovprod.com");
  gset(0.7,0.78,0.95,1);
  gfx_x = ui.px(32); gfx_y = ui.py(124); gfx_drawstr("A free creative audio effect for REAPER that goes beyond traditional reverse reverb.");
  gfx_x = ui.px(32); gfx_y = ui.py(150); gfx_drawstr("Combines reverse reverb processing with additional sound-shaping effects to create unique");
  gfx_x = ui.px(32); gfx_y = ui.py(167); gfx_drawstr("textures, transitions, vocal effects and experimental sounds.");
);
