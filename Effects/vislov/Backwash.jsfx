gfx_x = ui.px(376+182*log(10000/20)/6.9078+3); gfx_y = ui.py(372); gfx_drawstr("10k");
ghp = sv[8] > 25; glp = sv[9] < 19500;
gbl = abs(sv[42]) > 0.05;
gbl ? (
  gbell.bq_pk(sv[41],srate,sv[42],sv[43]);
  gbb0 = gbell.b0; gbb1 = gbell.b1; gbb2 = gbell.b2; gba1 = gbell.a1; gba2 = gbell.a2;
);
gx = 0; gprev = 320;
while (gx <= 180) (
  gf = 20*1000^(gx/182);
  gmg = 1;
  ghp ? ( gmg *= 1/sqrt(1+(sv[8]/gf)^4); );
  glp ? ( gmg *= 1/sqrt(1+(gf/sv[9])^4); );
  gbl ? (
    // exact biquad magnitude, evaluated as real + imaginary parts (no clamping: at low
    // frequencies both sums are extremely small, so any epsilon would flatten the curve)
    gw1 = 2*$pi*gf/srate;
    gcs = cos(gw1); gsn = sin(gw1); gcs2 = cos(2*gw1); gsn2 = sin(2*gw1);
    gnre = gbb0+gbb1*gcs+gbb2*gcs2; gnim = gbb1*gsn+gbb2*gsn2;
    gdre = 1+gba1*gcs+gba2*gcs2;    gdim = gba1*gsn+gba2*gsn2;
    gmg *= sqrt((gnre*gnre+gnim*gnim)/max(gdre*gdre+gdim*gdim,0.000000000000000000000000000001));
  );
  gdb = log(gmg)*8.6859;
  gyy = max(294,min(383,320-gdb*1.667));
  // fill column: snap edges to whole pixels so neighbours touch exactly (no overlap stripes at fractional scale)
  gfx0 = floor(ui.px(376+gx)); gfx1 = floor(ui.px(376+gx+2));
  gfy0 = floor(ui.py(gyy));    gfy1 = floor(ui.py(384));
  gset(0.3,0.7,1,0.16); gfx_rect(gfx0,gfy0,gfx1-gfx0,gfy1-gfy0);
  gx > 0 ? ( gset(0.4,0.82,1,1); ui.ln(376+gx-2,gprev,376+gx,gyy); );
  gprev = gyy;
  gx += 2;
);
