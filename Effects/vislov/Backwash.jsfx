about_on ? (
  gset(0.02,0.01,0.05,0.4); gfx_rect(0,0,gfx_w,gfx_h);        // dim the whole interface a little
  gset(0.04,0.02,0.09,0.92); ui.box(16,34,728,160);           // semi-transparent panel
  gset(0.42,0.5,1,0.9);                                       // border
